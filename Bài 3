struct Node
{
    int value;          // giá trị nút
    Node* left;         // con trỏ tới nút con trái
    Node* right;        // con trỏ tới nút con phải

    // Hàm tạo
    Node(int v, Node* l = NULL, Node* r = NULL)
    {
        value = v;
        left = l;
        right = r;
    }
};
class BSTree
{
private:
    Node* root;

    // Các hàm xử lý nội bộ (đệ quy)
    Node* insert(int val, Node* t);
    Node* search(int val, Node* t);
    void makeEmpty(Node* &t);

    void preOrder(Node* t);
    void inOrder(Node* t);
    void postOrder(Node* t);

public:
    BSTree();
    ~BSTree();

    bool isEmpty();
    void makeEmpty();

    void insert(int val);
    Node* search(int val);

    void preOrder();
    void inOrder();
    void postOrder();
};
BSTree::BSTree()
{
    root = NULL;
}

BSTree::~BSTree()
{
    makeEmpty();
}
bool BSTree::isEmpty()
{
    return root == NULL;
}
void BSTree::makeEmpty(Node* &t)
{
    if (t != NULL)
    {
        makeEmpty(t->left);
        makeEmpty(t->right);
        delete t;
        t = NULL;
    }
}

void BSTree::makeEmpty()
{
    makeEmpty(root);
}
Node* BSTree::insert(int val, Node* t)
{
    if (t == NULL)
        t = new Node(val);
    else if (val < t->value)
        t->left = insert(val, t->left);
    else if (val > t->value)
        t->right = insert(val, t->right);

    return t;
}

void BSTree::insert(int val)
{
    root = insert(val, root);
}
Node* BSTree::search(int val, Node* t)
{
    if (t == NULL)
        return NULL;
    if (val == t->value)
        return t;
    else if (val < t->value)
        return search(val, t->left);
    else
        return search(val, t->right);
}

Node* BSTree::search(int val)
{
    return search(val, root);
}
   void makeEmpty(Node*& t) {
        if (t != NULL) {
            makeEmpty(t->left);
            makeEmpty(t->right);
            delete t;
            t = NULL;
        }
    }

    // Chèn một nút mới vào cây (đệ quy)
    void insert(int val, Node*& t) {
        if (t == NULL) {
            t = new Node(val);
        } else if (val < t->data) {
            insert(val, t->left);
        } else if (val > t->data) {
            insert(val, t->right);
        }
        // nếu val == t->data thì không chèn (tránh trùng)
    }

    // Tìm kiếm nút có giá trị cho trước (đệ quy)
    Node* search(int val, Node* t) {
        if (t == NULL) return NULL;
        if (val == t->data) return t;
        if (val < t->data)
            return search(val, t->left);
        else
            return search(val, t->right);
    }

public:
    BSTree() {
        root = NULL;
    }

    ~BSTree() {
        makeEmpty(root);
    }

    void insert(int val) {
        insert(val, root);
    }

    Node* search(int val) {
        return search(val, root);
    }

    Node* getRoot() {
        return root;
    }
};

// Duyệt cây theo Preorder
void PREORDER_travl(Node* t) {
    if (t != NULL) {
        cout << t->data << " ";
        PREORDER_travl(t->left);
        PREORDER_travl(t->right);
    }
}

